# Copy to .env and replace the password before starting local infrastructure.
# Docker Compose reads .env automatically. Spring Boot does not.
DB_NAME=latensys
DB_USERNAME=latensys_local
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/latensys
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_TIMEOUT=2s
REDIS_CONNECT_TIMEOUT=2s
# Generate a BCrypt hash with: htpasswd -nBC 12 admin
# Copy only the hash after "admin:". Keep the quotes so Docker Compose does not interpolate $.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='replace-with-bcrypt-hash'
APP_UPSTREAM_URL=http://127.0.0.1:8081
APP_ALLOWED_PATHS=/hello,/fail,/echo,/stats,/slow
APP_CONNECT_TIMEOUT=2s
APP_REQUEST_TIMEOUT=5s
APP_MAX_REQUEST_BYTES=65536
APP_MAX_RESPONSE_BYTES=1048576
RATE_LIMIT_DEFAULT_MAX_REQUESTS=50
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_HELLO_MAX_REQUESTS=10
RATE_LIMIT_HELLO_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_MAX_REQUESTS=3
RATE_LIMIT_REDIS_WINDOW_SECONDS=60
RATE_LIMIT_APP_HELLO_MAX_REQUESTS=5
RATE_LIMIT_APP_HELLO_WINDOW_SECONDS=60
# Leave optional integrations unset for local development.
REDIS_PASSWORD=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERTS_ENABLED=false
ALERT_EVALUATION_DELAY_MS=60000
ALERT_MIN_REQUESTS=20
RETENTION_ENABLED=true
RETENTION_DAYS=30
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES=10
RETENTION_CLEANUP_DELAY_MS=3600000
