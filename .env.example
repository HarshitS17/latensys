# Copy to .env and replace the password before starting local infrastructure.
# Docker Compose reads .env automatically. Spring Boot does not.
DB_NAME=latensys
DB_USERNAME=latensys_local
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/latensys
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# Leave optional integrations unset for local development.
REDIS_PASSWORD=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
