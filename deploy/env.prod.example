# Copy to a private file such as deploy/env.prod and chmod 600 it.
# The example values are placeholders; never use them on a public VM.
DOMAIN=monitor.example.com
DB_NAME=latensys
DB_USERNAME=latensys
DB_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
ADMIN_USERNAME=admin
# Generate with: htpasswd -nBC 12 admin ; retain only the hash after admin:.
# Single quotes prevent Compose from interpreting bcrypt dollar signs.
ADMIN_PASSWORD_HASH='replace-with-bcrypt-hash'
# Optional local-only overrides: CADDYFILE_PATH=./deploy/Caddyfile.local,
# HTTP_PORT=18080, HTTPS_PORT=18443, DOMAIN=localhost.
