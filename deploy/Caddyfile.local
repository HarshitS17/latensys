localhost {
    tls internal
    encode zstd gzip
    reverse_proxy latensys:8080 {
        header_up X-Real-IP {remote_host}
        header_up -X-Forwarded-For
        header_up -Forwarded
    }
}

# Local UI capture only; the public Caddyfile does not serve HTTP application traffic.
http://localhost {
    reverse_proxy latensys:8080 {
        header_up X-Real-IP {remote_host}
        header_up -X-Forwarded-For
        header_up -Forwarded
    }
}
